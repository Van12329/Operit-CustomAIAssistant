  "subpackages": [
    {
      "id": "rem_speech_factory_probe_tools",
      "entry": "dist/packages/rem_speech_factory_probe_tools.js"
    }
  ],
  "resources": [
    {
      "key": "speech_factory_probe_helper",
      "path": "resources/speech-factory-probe-helper.dex",
      "mime": "application/vnd.android.dex"
    }
  ]
}
