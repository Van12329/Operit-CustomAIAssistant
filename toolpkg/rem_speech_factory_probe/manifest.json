{
  "schema_version": 1,
  "toolpkg_id": "com.rem.speech_factory_probe",
  "version": "0.1.0",
  "api_version": "1.0.0",
  "main": "dist/main.js",
  "display_name": {
    "en": "Rem Speech Factory Probe",
    "zh": "Rem Speech Factory Probe"
  },
