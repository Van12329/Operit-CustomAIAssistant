{
  "schema_version": 1,
  "toolpkg_id": "com.operit.android_voice_service_adapter",
  "version": "0.1.2",
  "api_version": "1.0.0",
  "main": "dist/main.js",
  "display_name": {
    "en": "Android VoiceService Adapter",
    "zh": "Android VoiceService Adapter"
  },
  "description": {
    "en": "Multilingual Android TTS routing adapter for Operit's VoiceServiceFactory. Routes Russian to the existing Russian voice and Spanish to es-US while preserving the stock VoiceService lifecycle, with last-mile Markdown sanitization and TTS/STT duplex lifecycle coordination.",
    "zh": "Multilingual Android TTS routing adapter."
  },
  "enabled_by_default": true,
  "subpackages": [
    {
      "id": "android_voice_service_adapter_tools",
      "entry": "dist/packages/android_voice_service_adapter_tools.js"
    }
  ],
  "resources": [
    {
      "key": "android_voice_service_adapter_helper",
      "path": "resources/android-voice-service-adapter-helper.dex",
      "mime": "application/vnd.android.dex"
    }
  ]
}
