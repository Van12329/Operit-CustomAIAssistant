{
  "schema_version": 1,
  "toolpkg_id": "com.rem.android_stt_bridge",
  "version": "0.7.1",
  "api_version": "1.0.0",
  "main": "dist/main.js",
  "display_name": {
    "en": "Rem Android STT Bridge",
    "zh": "Rem Android STT Bridge"
  },
  "description": {
    "en": "Replaces Operit's wake-session STT capture with Android SpeechRecognizer ru-RU without modifying the Operit APK.",
