  },
  "enabled_by_default": true,
  "subpackages": [
    {
      "id": "rem_android_stt_bridge_tools",
      "entry": "dist/packages/rem_android_stt_bridge_tools.js"
    }
  ],
  "resources": [
    {
      "key": "android_stt_bridge_helper",
      "path": "resources/android-stt-bridge-helper.dex",
      "mime": "application/vnd.android.dex"
    }
  ]
}
