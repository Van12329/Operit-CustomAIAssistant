{
  "schema_version": 1,
  "toolpkg_id": "com.operit.android_voice_service_probe",
  "version": "0.1.0",
  "api_version": "1.0.0",
  "main": "dist/main.js",
  "display_name": {
    "en": "Android VoiceService Probe",
    "zh": "Android VoiceService Probe"
  },
  "description": {
    "en": "Read-only probe for Operit VoiceServiceFactory injection and Android TTS voice/locale capabilities. Does not play audio.",
    "zh": "Read-only VoiceServiceFactory and Android TTS probe."
  },
  "enabled_by_default": true,
  "subpackages": [
    {
      "id": "android_voice_service_probe_tools",
      "entry": "dist/packages/android_voice_service_probe_tools.js"
    }
  ],
  "resources": [
    {
      "key": "android_voice_service_probe_helper",
      "path": "resources/android-voice-service-probe-helper.dex",
      "mime": "application/vnd.android.dex"
    }
  ]
}
